# Configuracion del Microservicio con OpenTelemetry

SERVICE_NAME=order-processing-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=production
PORT=8080
HOST=0.0.0.0

# Endpoint del recolector OTLP (Grafana Alloy o Tempo / Mimir directamente)
# Para gRPC:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Para HTTP:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Protocolo: 'grpc' o 'http'
OTEL_EXPORTER_PROTOCOL=grpc

# Tasa de muestreo de trazas: 1.0 = 100% de trazas capturadas
OTEL_SAMPLING_RATIO=1.0

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
